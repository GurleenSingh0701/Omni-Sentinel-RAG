# LM Studio runtime settings
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=local-model
LM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
STARTUP_HEALTHCHECK=false
FALLBACK_RESPONSE=I could not reach the local model server. Please verify LM Studio is running and try again.
VECTOR_CONTEXT_FILE=docs/company_overview.txt
TABULAR_DATA_FILE=data/revenue.csv
TABULAR_DATA_FILES=data/revenue.csv,data/incidents.csv,data/customers.csv

# Router behavior
TABULAR_KEYWORDS=revenue,table,data,numbers,quarter,quarters,q1,q2,q3,q4,year,years
TABULAR_METRIC_KEYWORDS=revenue,growth,customer,customers,renewal,margin,sla,incident,incidents,mttr,mtta,false_positive,nps,churn,segment,expansion_mrr,rate,pct,percent,kpi,trend,compare

# Feature flags (Phase 1: keep OFF to preserve baseline behavior)
ENABLE_GUARDRAILS=false
ENABLE_VERIFY=false
ENABLE_TRACING=false
ENABLE_EVAL_STUB_LLM=false

# Security and operational controls
ENABLE_INPUT_SANITIZATION=true
MAX_QUERY_CHARS=5000
ENABLE_LOG_REDACTION=true
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
